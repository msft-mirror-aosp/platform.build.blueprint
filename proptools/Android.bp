bootstrap_go_package {
    name: "blueprint-proptools",
    pkgPath: "github.com/google/blueprint/proptools",
    deps: [
        "blueprint-optional",
        "blueprint-parser",
        "blueprint-pool",
        "blueprint-proptools-type_test1",
        "blueprint-proptools-type_test2",
        "blueprint-syncmap",
    ],
    srcs: [
        "clone.go",
        "configurable.go",
        "escape.go",
        "extend.go",
        "filter.go",
        "hash_provider.go",
        "hash_type.go",
        "proptools.go",
        "repack.go",
        "tag.go",
        "typeequal.go",
        "unpack.go",
        "utils.go",
    ],
    testSrcs: [
        "clone_test.go",
        "configurable_test.go",
        "escape_test.go",
        "extend_test.go",
        "filter_test.go",
        "hash_provider_test.go",
        "hash_type_test.go",
        "repack_test.go",
        "tag_test.go",
        "typeequal_test.go",
        "unpack_test.go",
    ],
    visibility: [
        // used by plugins
        "//visibility:public",
    ],
}
